VITE_API_BASE_URL=http://localhost:5000/api

# Browser environment variables are embedded in the public JavaScript bundle.
# Never put passwords, private keys, server tokens, or secret API credentials in VITE_* variables.
# Firebase web config and the Web Push VAPID key below are public client identifiers, not secrets.
# Restrict the Firebase API key to this site's domain in Google/Firebase Console.
# Firebase Cloud Messaging (push notifications) - from Firebase Console ->
# Project Settings -> General -> Your apps (Web app config).
# Keep provider service-account/private keys in backend environment variables only.
VITE_FIREBASE_API_KEY=your_firebase_api_key_placeholder
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_placeholder
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id_placeholder
VITE_FIREBASE_APP_ID=your_firebase_app_id_placeholder
# Project Settings -> Cloud Messaging -> Web Push certificates -> generate/copy key pair
VITE_FIREBASE_VAPID_KEY=your_firebase_vapid_key_placeholder
