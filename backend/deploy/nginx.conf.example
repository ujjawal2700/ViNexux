# Example nginx site for the VPS: serves the built frontend and proxies /api
# to the PM2 cluster (ecosystem.config.cjs) on 127.0.0.1:5000.
# Copy to /etc/nginx/sites-available/vinexus, adjust server_name and paths,
# symlink into sites-enabled, then: sudo nginx -t && sudo systemctl reload nginx
# Add HTTPS with: sudo certbot --nginx -d example.com -d www.example.com

upstream vinexus_api {
    server 127.0.0.1:5000;
    # Reuse connections to Node instead of opening one per request.
    # Node's keepAliveTimeout (65s) is longer than nginx's default (60s).
    keepalive 64;
}

server {
    listen 80;
    server_name example.com www.example.com;

    # Frontend build output (frontend/dist), with VITE_API_BASE_URL=https://example.com/api
    root /var/www/vinexus/frontend/dist;
    index index.html;

    client_max_body_size 100m;  # product import: 2 files x 50 MB (multer limit)

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/css application/javascript application/json image/svg+xml application/xml application/manifest+json;

    # Cache only public static files; authenticated API responses are untouched.
    location /theme-assets/ {
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }


    location /api/ {
        proxy_pass http://vinexus_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # The API trusts these from loopback only (TRUST_PROXY=loopback).
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;    # bulk product imports
    }

    # Hashed build assets never change: cache for a year.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # The service worker and app shell must always be fresh after a deploy.
    location = /firebase-messaging-sw.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    # PWA assets must be served as files, without authentication or SPA fallback.
    location ~ ^/(?:admin/)?manifest\.webmanifest$ {
        types { } default_type application/manifest+json;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    location = /admin/sw.js {
        types { } default_type application/javascript;
        add_header Cache-Control "no-cache";
        add_header Service-Worker-Allowed "/admin/";
        try_files $uri =404;
    }
    location = /admin/offline.html {
        add_header Cache-Control "no-cache";
        add_header X-Robots-Tag "noindex";
        try_files $uri =404;
    }

    location = /sitemap.sxml {
        return 301 /sitemap.xml;
    }
    location ~ ^/(sitemap(?:-pages|-products-[1-9][0-9]*)?\.xml)$ {
        rewrite ^/(.*)$ /api/seo/$1 last;
    }

    location = /index.html {
        rewrite ^ /api/share-page?path=/index.html break;
        proxy_pass http://vinexus_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Render page metadata before sending HTML so sharing crawlers see product images.
    # The root must also use the renderer to pick up the admin's generic social image.
    location = / {
        rewrite ^ /api/share-page?path=/ break;
        proxy_pass http://vinexus_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location / {
        try_files $uri $uri/ @storefront_page;
    }
    location @storefront_page {
        rewrite ^ /api/share-page?path=$uri break;
        proxy_pass http://vinexus_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
